{
  "name": "@chamber/nutrition-dg",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The v0 nutrition datagram — three handlers over @chamber/datagram's typed string-free data layer, served over HTTP, MCP, and a CLI.",
  "license": "MIT",
  "scripts": {
    "serve": "node --import tsx src/http.ts",
    "mcp": "node --import tsx src/mcp.ts",
    "cli": "node --import tsx src/cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "test:live": "node --env-file=../../.env --import tsx --test test/live/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.103.0",
    "@bufbuild/protobuf": "^2.2.3",
    "@chamber/datagram": "*"
  }
}
