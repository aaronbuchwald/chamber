# Copy this file to `.env` and fill in real values. `.env` is gitignored;
# this template is safe to commit. `start.sh` loads `.env` into the gateway's
# environment, and agentgateway passes it through to the spawned MCP servers.

# Obsidian Local REST API plugin key (required for the obsidian_* tools).
# Get it in Obsidian: Settings → Community plugins → Local REST API → API Key.
OBSIDIAN_API_KEY=your-local-rest-api-key-here

# Google Calendar MCP server (official remote server at calendarmcp.googleapis.com).
# Create an OAuth "Web application" client in Google Cloud Console with redirect URI
# http://localhost:<GOOGLE_CALENDAR_CALLBACK_PORT>/callback and read-only Calendar scopes.
GOOGLE_CALENDAR_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_CALENDAR_CALLBACK_PORT=8080

# Nutrition: log_meal resolves unknown meal components from an external source and caches
# them locally, in one call. NUTRITION_PROVIDER picks the strategy (see
# apps/nutrition/src/strategies.ts): local | usda | calorieninjas | llm. Unset = usda.
NUTRITION_PROVIDER=usda

# usda (default): works with no key via USDA's shared DEMO_KEY; set a key to raise the rate
# limit. Free key: https://fdc.nal.usda.gov/api-key-signup.html
USDA_FDC_API_KEY=your-usda-fdc-api-key-here

# Required when NUTRITION_PROVIDER=calorieninjas. Key: https://calorieninjas.com/api
CALORIENINJAS_API_KEY=your-calorieninjas-api-key-here

# Required when NUTRITION_PROVIDER=llm — estimates per-100g nutrition via the Anthropic API
# (claude-opus-4-8) instead of a database lookup.
ANTHROPIC_API_KEY=sk-ant-your-key-here
